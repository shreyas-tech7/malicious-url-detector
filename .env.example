# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) / ml/.env (training scripts) and fill in.
# NEVER commit real values. All secrets are server-side only — note that none
# of these are NEXT_PUBLIC_*, which is deliberate.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project ref is the subdomain of your project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# The RESTRICTED key the server normally runs on. Constrained by the RLS
# policies in supabase/schema.sql: it can append to the prediction log and read
# the hash corpus, but CANNOT read a single submitted URL back. Either name
# works; publishable is the modern format.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# service_role key: BYPASSES RLS entirely. Optional, and takes precedence when
# set. Preferred if you have it -- supplying it lets the two malicious_hashes
# write policies be dropped, closing the corpus-poisoning path. Server-side
# only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Threat intel feeds ---------------------------------------------------
# URLhaus (abuse.ch). NOTE: the bulk CSV downloads under
# https://urlhaus.abuse.ch/downloads/ are currently reachable WITHOUT a key;
# only the api endpoints (urlhaus-api.abuse.ch) require one. Set this if you
# want the pipeline to use the authenticated API instead of the bulk dumps.
URLHAUS_AUTH_KEY=

# --- Internal ------------------------------------------------------------
# Random string. Salts the SHA-256 of client IPs before they are logged, so
# stored hashes are not reversible via a rainbow table of the IPv4 space.
IP_HASH_SALT=

# Shared secret required by Vercel Cron to invoke the refresh endpoint.
CRON_SECRET=

# Base URL of the Python inference function, used by the Next.js API routes.
# Leave unset locally to default to http://127.0.0.1:8000
INFERENCE_BASE_URL=

# --- Model behaviour -----------------------------------------------------
# Bounds of the "uncertain" band. Scores inside it are reported as
# `uncertain` rather than forced into a binary call. Defaults measured from the
# score distribution: this band is 14% of traffic but holds 66% of the errors.
UNCERTAIN_LOW=0.20
UNCERTAIN_HIGH=0.80
