# Environment files (never commit real secrets; keep .env.example)
.env
.env.*
.env*.local
ml/.env
ml/.env.*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Python / ML virtual environments and caches
ml/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Raw + processed datasets are large or subject to third-party feed terms and
# are rebuildable via `python ml/data_acquisition.py` and `python ml/build_dataset.py`.
# We commit the acquisition scripts and provenance manifest, not the bulk data.
ml/data/raw/*
ml/data/processed/*
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep
!ml/data/**/MANIFEST.json
*.parquet

# Model artifacts ARE committed (the serverless function needs them at runtime)
# — see ml/artifacts/. Nothing to ignore there.
